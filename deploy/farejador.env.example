# Copy of this file lives on the server as /opt/farejador/secrets/farejador.env
# (owner root, mode 600). Never commit real values.
#
# The mode, port and bind address are set by docker-compose.server.yml and the image.

# GitHub App
FAREJADOR_GITHUB_APP_ID=
FAREJADOR_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# The secret configured in the App's webhook settings.
FAREJADOR_WEBHOOK_SECRET=

# OpenRouter: your API key and the model (it must support tool calling).
FAREJADOR_OPENROUTER_API_KEY=
FAREJADOR_MODEL=

# Optional settings and their defaults
# FAREJADOR_TRIGGER_TEXT=@farejador
# FAREJADOR_BOT_LOGIN=
# FAREJADOR_WORKERS=2
# FAREJADOR_MAX_STEPS=15
# FAREJADOR_MAX_TOKENS=200000
# FAREJADOR_MAX_SECONDS=300
# FAREJADOR_MAX_FILES=40
# FAREJADOR_IGNORE_GLOBS=
# FAREJADOR_LOG_LEVEL=INFO
