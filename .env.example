# Copy to .env (never commit it) and fill in the values.
# The GitHub App private key is NOT set here: mount the .pem file (see README).

# polling (local), webhook (server) or both. Compose profiles set this for you.
FAREJADOR_MODE=polling

# GitHub App
FAREJADOR_GITHUB_APP_ID=
FAREJADOR_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# Required in webhook and both modes: the secret configured in the App's webhook settings.
FAREJADOR_WEBHOOK_SECRET=

# OpenRouter: your API key and the model to use (it must support tool calling).
FAREJADOR_OPENROUTER_API_KEY=
FAREJADOR_MODEL=

# Optional settings and their defaults
# FAREJADOR_TRIGGER_TEXT=@nome-do-seu-app
# FAREJADOR_BOT_LOGIN=
# FAREJADOR_POLL_INTERVAL_S=60
# FAREJADOR_WORKERS=2
# FAREJADOR_MAX_STEPS=15
# FAREJADOR_MAX_TOKENS=200000
# FAREJADOR_MAX_SECONDS=300
# FAREJADOR_REASONING_EFFORT=high
# FAREJADOR_MAX_FILES=40
# FAREJADOR_IGNORE_GLOBS=
# FAREJADOR_STATE_PATH=/data/farejador.db
# FAREJADOR_TRACE_ENABLED=true
# FAREJADOR_TRACE_PATH=/data/trace.db
# FAREJADOR_TRACE_RETENTION_DAYS=30
# FAREJADOR_TRACE_MAX_ITEM_CHARS=20000
# FAREJADOR_TRACE_MAX_RUN_BYTES=2097152
# FAREJADOR_HOST=127.0.0.1   # the Docker image sets 0.0.0.0
# FAREJADOR_PORT=8080
# FAREJADOR_LOG_LEVEL=INFO
