{
  "name": "farejador-web",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only dashboard of the Farejador review trace (TypeScript, no runtime dependencies)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "e2e": "node scripts/build.mjs && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3"
  }
}
